{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tooling/typescript-config/library-transitional.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "incremental": false
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": [
    "node_modules",
    "unit/apps/admin/**",
    "unit/apps/donor/**",
    "unit/apps/missionary/**",
    "unit/packages/ui/**",
    "unit/cms/**",
    "unit/acceptance/issue-2364/**",
    "unit/packages/api/principal/**",
    "unit/packages/api/projection/**",
    "fixtures/base-ui-compliance/**",
    "fixtures/capability-registry/**"
  ]
}
