{
  "name": "@asym/pdf-renderer",
  "version": "0.0.0",
  "description": "Print rendering boundary for the Asym PDF Document Builder.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "readme.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./docraptor-preview": {
      "import": {
        "types": "./dist/docraptor-preview.d.mts",
        "default": "./dist/docraptor-preview.mjs"
      },
      "require": {
        "types": "./dist/docraptor-preview.d.cts",
        "default": "./dist/docraptor-preview.cjs"
      }
    },
    "./local-renderer": {
      "import": {
        "types": "./dist/local-renderer.d.mts",
        "default": "./dist/local-renderer.mjs"
      },
      "require": {
        "types": "./dist/local-renderer.d.cts",
        "default": "./dist/local-renderer.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asymmetric-al/react-PDF.git",
    "directory": "packages/pdf-renderer"
  },
  "keywords": [
    "asym",
    "pdf",
    "renderer",
    "docraptor"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@asym/docraptor-client": "0.0.0",
    "@asym/pdf-template-schema": "0.0.0"
  }
}
