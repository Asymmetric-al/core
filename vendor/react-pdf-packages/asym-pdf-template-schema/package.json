{
  "name": "@asym/pdf-template-schema",
  "version": "0.0.0",
  "description": "Shared template schema boundary for the Asym PDF Document Builder.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "readme.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asymmetric-al/react-PDF.git",
    "directory": "packages/pdf-template-schema"
  },
  "keywords": [
    "asym",
    "pdf",
    "template",
    "schema"
  ],
  "dependencies": {
    "zod": "4.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
