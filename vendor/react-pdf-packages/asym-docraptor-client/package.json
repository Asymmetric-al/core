{
  "name": "@asym/docraptor-client",
  "version": "0.0.0",
  "description": "Server-only DocRaptor client boundary for the Asym PDF Document Builder.",
  "private": true,
  "type": "module",
  "files": [
    "dist/**",
    "readme.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asymmetric-al/react-PDF.git",
    "directory": "packages/docraptor-client"
  },
  "keywords": [
    "asym",
    "docraptor",
    "pdf"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@asym/pdf-template-schema": "0.0.0"
  }
}
