{
  "name": "@asym/docraptor-client",
  "version": "0.1.0",
  "description": "Server-only DocRaptor client boundary for the Asym PDF Document Builder.",
  "private": true,
  "type": "module",
  "files": [
    "dist/**",
    "readme.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asymmetric-al/react-PDF.git",
    "directory": "packages/docraptor-client"
  },
  "keywords": [
    "asym",
    "docraptor",
    "pdf"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "tsconfig": "0.0.0",
    "tsdown": "0.23.1",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@asym/pdf-template-schema": "0.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit"
  }
}