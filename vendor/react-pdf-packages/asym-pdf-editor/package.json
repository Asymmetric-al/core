{
  "name": "@asym/pdf-editor",
  "version": "0.1.0",
  "description": "React PDF editor boundary for the Asym PDF Document Builder.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "readme.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./extensions": {
      "import": {
        "types": "./dist/extensions.d.mts",
        "default": "./dist/extensions.mjs"
      },
      "require": {
        "types": "./dist/extensions.d.cts",
        "default": "./dist/extensions.cjs"
      }
    },
    "./migration/unlayer": {
      "import": {
        "types": "./dist/migration/unlayer.d.mts",
        "default": "./dist/migration/unlayer.mjs"
      },
      "require": {
        "types": "./dist/migration/unlayer.d.cts",
        "default": "./dist/migration/unlayer.cjs"
      }
    },
    "./react-email-compat": {
      "import": {
        "types": "./dist/react-email-compat.d.mts",
        "default": "./dist/react-email-compat.mjs"
      },
      "require": {
        "types": "./dist/react-email-compat.d.cts",
        "default": "./dist/react-email-compat.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asymmetric-al/react-PDF.git",
    "directory": "packages/pdf-editor"
  },
  "keywords": [
    "asym",
    "pdf",
    "editor",
    "react",
    "tiptap"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "peerDependencies": {
    "react": "^18.0 || ^19.0 || ^19.0.0-rc",
    "react-dom": "^18.0 || ^19.0 || ^19.0.0-rc"
  },
  "dependencies": {
    "@asym/pdf-template-schema": "0.1.0",
    "@react-email/editor": "1.7.14",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsconfig": "0.0.0",
    "tsdown": "0.23.1",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "@vitest/browser-playwright": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "playwright": "1.64.1"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  }
}