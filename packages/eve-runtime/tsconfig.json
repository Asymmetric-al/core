{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023.Intl"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts"
  ]
}
