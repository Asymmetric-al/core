{
  "$schema": "https://turbo.build/schema.v2.json",
  "envMode": "loose",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_TARGET_ENV",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_SHA"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "tsconfig.tsbuildinfo",
        "*.tsbuildinfo",
        "**/*.tsbuildinfo"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "GOOGLE_SITE_VERIFICATION",
        "BING_SITE_VERIFICATION",
        "SUPABASE_*",
        "PAYLOAD_SECRET",
        "DATABASE_URL",
        "PAYLOAD_DATABASE_URI",
        "PAYLOAD_DATABASE_POOL_MAX",
        "DONOR_APP_URL",
        "SKIP_ENV_VALIDATION",
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "RESEND_ENCRYPTION_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "CLOUDINARY_API_SECRET",
        "ALLOW_DEMO_ACCOUNTS",
        "DEMO_ONLY_LOGIN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": [],
      "passThroughEnv": [
        "CI",
        "NODE_OPTIONS",
        "FORCE_COLOR",
        "NO_COLOR",
        "TERM"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": ["tsconfig.tsbuildinfo", "*.tsbuildinfo", "**/*.tsbuildinfo"],
      "passThroughEnv": ["CI", "NODE_OPTIONS", "FORCE_COLOR", "NO_COLOR"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "NODE_OPTIONS",
        "VITEST_*",
        "DEBUG",
        "FORCE_COLOR",
        "NO_COLOR"
      ]
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "CI",
        "NODE_OPTIONS",
        "VITEST_*",
        "DEBUG",
        "FORCE_COLOR",
        "NO_COLOR"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "test:a11y": {
      "cache": false
    },
    "test:perf": {
      "cache": false
    },
    "lighthouse": {
      "cache": false
    },
    "verify": {
      "cache": false
    },
    "verify:e2e": {
      "cache": false
    },
    "verify:e2e:loop": {
      "cache": false,
      "persistent": true
    },
    "generate:icons": {
      "cache": false
    },
    "setup": {
      "cache": false
    },
    "setup:verify": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
