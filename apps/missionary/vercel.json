{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bunx bun@1.4.3 install --cwd ../.. --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run build:missionary",
  "ignoreCommand": "node ../../scripts/vercel/should-ignore-build.mjs missionary",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "develop": false,
      "production": false,
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/stripe",
      "destination": "/missionary/api/webhooks/stripe"
    }
  ]
}
