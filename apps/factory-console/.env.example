# Core factory Console: server-only configuration. Nothing here is NEXT_PUBLIC_*
# and nothing here is ever sent to the browser. On VM 100 these live in
# /home/admin/.config/core-factory-console/owner.env (mode 0600), loaded by
# core-factory-console.service. Values shown are the VM 100 defaults; the
# FACTORY_* defaults below are also built into the server, so only the first
# block is strictly required.

# --- Required: owner boundary and engine identity -------------------------
# Exact browser origin through the owner's SSH tunnel (scheme, host, port).
CONSOLE_ORIGIN=http://127.0.0.1:39342
# HTTP Basic user and a private password of at least 24 characters.
CONSOLE_OWNER=conrad
CONSOLE_PASSWORD=
# The single Archon 0.14.0 engine (service core-archon) on guest loopback.
ARCHON_URL=http://127.0.0.1:39190
# GET /api/health storeId of that engine, and the codebase id of the
# `_folder/control` project every factory run executes in.
ARCHON_STORE_ID=
ARCHON_CODEBASE_ID=

# --- Factory state reader (archon state get|list) -------------------------
# Absolute executable, or a JSON argv array (the pack's ARCHON_CLI_COMMAND form).
FACTORY_ARCHON_CLI=/opt/archon/0.14.0/archon
FACTORY_STATE_PROJECT=_folder/control
FACTORY_ARCHON_HOME=/srv/core-factory/archon
FACTORY_ARCHON_USER_ID=core-factory
FACTORY_SERVICE_HOME=/home/admin
FACTORY_CLAUDE_PROFILE=/home/admin/.claude
FACTORY_PATH=/usr/bin:/bin

# --- Operator controls (node control.mjs <command> ...) -------------------
# Node used to run control.mjs; defaults to the Console's own node.
FACTORY_NODE=/opt/node-v24.22.1-linux-x64/bin/node
FACTORY_CONTROL_SCRIPT=/srv/core-factory/control/.archon/workflows/core-factory/.shared/control.mjs
# Working directory for every spawned factory process.
FACTORY_CONTROL_CWD=/srv/core-factory/control
# The factory configuration: passed to control.mjs as CORE_FACTORY_CONFIG, and
# the only source of the scope owners (`owners`) and the selector's admission
# limit (`limits.admittedIssues`) the Console shows. Unreadable values are
# shown as unavailable; there is no built-in owner or limit.
FACTORY_CONFIG_FILE=/srv/core-factory/control/core-factory.json

# --- Console behaviour ----------------------------------------------------
# Repository for issue/PR links.
FACTORY_REPOSITORY=Asymmetric-al/core
# Bounded process timeouts (milliseconds).
FACTORY_READ_TIMEOUT_MS=20000
FACTORY_CONTROL_TIMEOUT_MS=90000
# TEST-ONLY: labels every page as synthetic fixture data. Never set on VM 100.
FACTORY_FIXTURE_LABEL=
