    "kind": "sequence",
    "label": "Application flow",
    "steps": [
      {
        "id": "application_submission",
        "kind": "evidence",
        "label": "Application submission",
        "contract": "submission",
        "role": "candidate"
      },
      {
        "id": "assessment",
        "kind": "parallel",
        "label": "Assessment",
        "branches": [
          {
            "id": "references",
            "body": {
              "id": "references",
              "kind": "evidence",
              "label": "References",
              "contract": "references",
              "role": "coordinator"
            }
          },
          {
            "id": "interviews",
            "body": {
              "id": "interviews",
              "kind": "evidence",
              "label": "Interviews",
              "contract": "interviews",
              "role": "coordinator"
            }
          },
          {
            "id": "screening",
            "body": {
