              "op": "compare",
              "operator": "eq",
              "left": {
                "ref": {
                  "scope": "fact",
                  "key": "decision"
                }
              },
              "right": {
                "literal": "accepted"
              }
            },
            "then": {
              "id": "accepted_path",
              "kind": "sequence",
              "label": "Accepted path",
              "steps": [
                {
                  "id": "onboarding",
                  "kind": "subflow",
                  "label": "Onboarding",
                  "contract": "onboarding",
                  "inputs": {}
                },
                {
                  "id": "complete",
                  "kind": "finish",
                  "label": "Complete",
                  "lifecycle": "complete",
                  "outcome": "onboarded_not_deployed"
                }
              ]
            }
          },
          {
            "id": "conditional",
            "when": {
              "op": "compare",
              "operator": "eq",
              "left": {
                "ref": {
                  "scope": "fact",
                  "key": "decision"
                }
              },
              "right": {
                "literal": "conditional"
              }
            },
            "then": {
              "id": "conditional_path",
              "kind": "sequence",
              "label": "Conditional path",
              "steps": [
                {
                  "id": "conditions",
                  "kind": "evidence",
                  "label": "Conditions",
                  "contract": "conditions",
                  "role": "candidate"
                },
                {
                  "id": "conditions_review",
                  "kind": "evidence",
                  "label": "Conditions review",
                  "contract": "conditions_review",
                  "role": "decision_reviewer"
                },
                {
                  "id": "conditional_onboarding",
                  "kind": "subflow",
                  "label": "Conditional onboarding",
                  "contract": "onboarding",
                  "inputs": {}
                },
                {
                  "id": "conditional_complete",
                  "kind": "finish",
                  "label": "Conditional complete",
                  "lifecycle": "complete",
                  "outcome": "onboarded_not_deployed"
                }
              ]
            }
          },
          {
            "id": "declined",
            "when": {
              "op": "compare",
              "operator": "eq",
              "left": {
                "ref": {
                  "scope": "fact",
                  "key": "decision"
                }
              },
              "right": {
                "literal": "declined"
              }
            },
            "then": {
              "id": "decline",
              "kind": "finish",
              "label": "Decline",
              "lifecycle": "discontinued",
              "outcome": "declined"
            }
          },
          {
            "id": "withdrawn",
            "when": {
              "op": "compare",
              "operator": "eq",
              "left": {
                "ref": {
                  "scope": "fact",
                  "key": "decision"
                }
              },
              "right": {
                "literal": "withdrawn"
              }
            },
            "then": {
              "id": "withdraw",
              "kind": "finish",
              "label": "Withdraw",
              "lifecycle": "discontinued",
              "outcome": "withdrawn"
            }
          },
          {
            "id": "deferred",
            "when": {
              "op": "compare",
              "operator": "eq",
              "left": {
                "ref": {
                  "scope": "fact",
                  "key": "decision"
                }
              },
              "right": {
                "literal": "deferred"
