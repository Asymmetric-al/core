  "metadata": {
    "c-filters-7": {
      "name": "c-filters-7",
      "type": "example",
      "title": "Filtering a table",
      "description": "The query tree compiled to a row predicate.",
      "category": "filters",
      "free": true,
      "install": "npx shadcn@latest add @reui/c-filters-7",
      "docsUrl": "https://reui.io/components/filters/c-filters-7?ref=mcp",
      "previewUrl": "https://reui.io/preview/base/components/c-filters-7?ref=mcp",
      "thumbnail": "https://reui.io/thumbnails/components/c-filters-7-light.webp",
      "componentsUsed": ["badge", "data-grid", "filters"],
      "registryDependencies": [
        "avatar",
        "badge",
        "card",
        "data-grid",
        "data-grid-column-header",
        "data-grid-pagination",
        "data-grid-scroll-area",
        "data-grid-table",
        "filters",
        "filters-query",
        "filters-types"
      ],
      "dependencies": ["@tanstack/react-table", "cn"],
      "thumbnailDark": "https://reui.io/thumbnails/components/c-filters-7-dark.webp",
      "componentDigests": {
        "badge": "Text child; shadcn-compatible. `variant` (solid, `-outline`, `-light` per color), `size` xs..xl, `radius` default|full. Prefer Badge variants over raw color classes for statuses.",
        "data-grid": "Build a TanStack v9 `useTable({ features: dataGridFeatures, data, columns })` instance and pass `<DataGrid table={table} recordCount={total}><DataGridTable/></DataGrid>`. No `data`/`columns` props and never a hand-rolled `<table>`; drive layout via `tableLayout`, not ad-hoc classes. Read the full api for server fetch + features.",
        "filters": "Required `fields` (`FilterField[]`, nested via each field's own `fields`). The value is ONE `FilterQuery` TREE - `query` + `onQueryChange`, or uncontrolled `defaultQuery` - not an array of chips; seed it with `createFilterQuery()` and read it with `flattenFilterConditions`. `variant` `basic`|`advanced` picks the chrome (`advancedMode` `popover`|`inline`); both edit the same tree. The pre-rewrite `filters`/`onChange` props and `createFilter()` no longer exist. Pairs with `data-grid`."
      },
      "next": "Show the user this item as a markdown image from `thumbnail`, linked to `previewUrl`, before installing it."
    },
