  "publicApiContracts": [
    {
      "endpoint": "GET /api/cms/public/pages/[...slug]",
      "behavior": [
        "resolve tenant by query param, then domain, then subdomain",
        "normalize slug path segments",
        "query pages by tenant + slug + _status=published",
        "sort by -updatedAt and return first doc"
      ],
      "successPayloadTemplate": {
        "tenant": { "id": "<tenantId>", "slug": "<slug>" },
        "page": {}
      },
      "errorPayloads": [
        { "status": 404, "body": { "error": "Tenant not found" } },
        { "status": 404, "body": { "error": "Page not found" } },
        {
          "status": 500,
          "body": { "error": "Failed to fetch page content" }
        }
      ]
    },
    {
      "endpoint": "GET /api/cms/public/navigation",
      "behavior": [
        "resolve tenant",
        "query navigation by tenant sorted by -updatedAt",
        "return first doc or null"
      ],
      "successPayloadTemplate": {
        "tenant": { "id": "<tenantId>", "slug": "<slug>" },
        "navigation": {}
      },
      "errorPayloads": [
        { "status": 404, "body": { "error": "Tenant not found" } },
        {
          "status": 500,
          "body": { "error": "Failed to fetch navigation content" }
        }
      ]
    },
    {
      "endpoint": "GET /api/cms/public/updates?limit=N",
      "behavior": [
        "resolve tenant",
        "clamp limit between 1 and 20 with default 5",
        "query ministry-updates by tenant + _status=published sorted by -publishedAt"
      ],
      "successPayloadTemplate": {
        "tenant": { "id": "<tenantId>", "slug": "<slug>" },
        "updates": []
      },
      "errorPayloads": [
        { "status": 404, "body": { "error": "Tenant not found" } },
        {
          "status": 500,
          "body": { "error": "Failed to fetch ministry updates" }
        }
      ]
    }
  ],
  "verificationEvidence": {
    "unit": "bun run test:unit:cms (8 files, 40 tests passed)",
    "e2eCms": "bun run test:e2e:cms --project=chromium (4 passed)",
    "eslint": "targeted route/test lint checks passed",
    "typecheck": "bunx turbo run typecheck --filter=@asym/admin passed"
  },
  "limitations": [
    "full authenticated browser authoring verification is environment-dependent on reachable Postgres"
  ]
}
