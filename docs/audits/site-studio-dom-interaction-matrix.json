{
  "version": "2026-02-23",
  "scope": "apps/admin Payload collections and public CMS APIs",
  "collections": [
    {
      "collection": "pages",
      "adminListRoute": "/admin/collections/pages",
      "createRoute": "/admin/collections/pages/create",
      "editRoutePattern": "/admin/collections/pages/:id",
      "coreInteractions": [
        "rich text page authoring",
        "autosave drafts",
        "save and publish actions"
      ],
      "validationBehavior": [
        "tenant required and indexed",
        "title required",
        "slug required and indexed",
        "content required",
        "tenant auto-injected for non-super-admin"
      ],
      "publishBehavior": {
        "draftsEnabled": true,
        "autosaveIntervalSeconds": 300,
        "publishStateField": "_status",
        "publishedValue": "published"
      },
      "apiWiring": {
        "admin": ["POST /api/pages", "PATCH /api/pages/:id"],
        "public": ["GET /api/cms/public/pages/[...slug]"]
      }
    },
    {
      "collection": "navigation",
      "adminListRoute": "/admin/collections/navigation",
      "createRoute": "/admin/collections/navigation/create",
      "editRoutePattern": "/admin/collections/navigation/:id",
      "coreInteractions": [
        "array repeater item add/remove/reorder",
        "tenant-scoped navigation editing"
      ],
      "validationBehavior": [
        "tenant required",
        "label required",
        "items required",
        "items[].label required",
        "items[].href required",
        "items[].openInNewTab default false"
      ],
      "publishBehavior": {
        "draftsEnabled": false,
        "notes": "save is immediately current"
      },
      "apiWiring": {
        "admin": ["POST /api/navigation", "PATCH /api/navigation/:id"],
        "public": ["GET /api/cms/public/navigation"]
      }
    },
    {
      "collection": "missionary-profiles",
      "adminListRoute": "/admin/collections/missionary-profiles",
      "createRoute": "/admin/collections/missionary-profiles/create",
      "editRoutePattern": "/admin/collections/missionary-profiles/:id",
      "coreInteractions": [
        "profile content editing",
        "optional portrait relationship selection"
      ],
      "validationBehavior": [
        "tenant required",
        "fullName required",
        "slug required and indexed",
        "portrait optional relationship to media"
      ],
      "publishBehavior": {
        "draftsEnabled": false
      },
      "apiWiring": {
        "admin": [
          "POST /api/missionary-profiles",
          "PATCH /api/missionary-profiles/:id"
        ],
        "public": []
      }
    },
    {
      "collection": "ministry-updates",
      "adminListRoute": "/admin/collections/ministry-updates",
      "createRoute": "/admin/collections/ministry-updates/create",
      "editRoutePattern": "/admin/collections/ministry-updates/:id",
      "coreInteractions": [
        "rich text update authoring",
        "relationship selection for missionary profile",
        "optional publishedAt control"
      ],
      "validationBehavior": [
        "tenant required and indexed",
        "missionary required and indexed",
        "title required",
        "slug required and indexed",
        "content required"
      ],
      "publishBehavior": {
        "draftsEnabled": true,
        "autosaveIntervalSeconds": 300,
        "publishStateField": "_status",
        "publishedValue": "published"
      },
      "apiWiring": {
        "admin": [
          "POST /api/ministry-updates",
          "PATCH /api/ministry-updates/:id"
        ],
        "public": ["GET /api/cms/public/updates"]
      }
    },
    {
      "collection": "media",
      "adminListRoute": "/admin/collections/media",
      "createRoute": "/admin/collections/media/create",
      "editRoutePattern": "/admin/collections/media/:id",
      "coreInteractions": [
        "file upload",
        "metadata editing",
        "generated image size outputs"
      ],
      "validationBehavior": [
        "tenant required and indexed",
        "alt required",
        "caption optional"
      ],
      "publishBehavior": {
        "draftsEnabled": false
      },
      "apiWiring": {
        "admin": ["POST /api/media", "PATCH /api/media/:id"],
        "public": []
      }
    },
    {
      "collection": "tenants",
      "adminListRoute": "/admin/collections/tenants",
      "createRoute": "/admin/collections/tenants/create",
      "editRoutePattern": "/admin/collections/tenants/:id",
      "coreInteractions": ["tenant metadata management"],
      "validationBehavior": [
        "name required",
        "slug required and unique",
        "isActive default true"
      ],
      "publishBehavior": {
        "draftsEnabled": false
      },
      "apiWiring": {
        "admin": ["POST /api/tenants", "PATCH /api/tenants/:id"],
        "public": ["indirect via tenant resolver lookups"]
      }
    },
    {
      "collection": "cms-users",
      "adminListRoute": "/admin/collections/cms-users",
      "createRoute": "/admin/collections/cms-users/create",
      "editRoutePattern": "/admin/collections/cms-users/:id",
      "coreInteractions": [
        "CMS user role assignment",
        "Supabase identity linkage via supabaseUserId"
      ],
      "validationBehavior": [
        "email required and unique",
        "role select default staff",
        "local auth disabled, Supabase strategy required"
      ],
      "publishBehavior": {
        "draftsEnabled": false,
        "notes": "auth collection"
      },
      "apiWiring": {
        "admin": ["POST /api/cms-users", "PATCH /api/cms-users/:id"],
        "public": []
      }
    }
  ],
