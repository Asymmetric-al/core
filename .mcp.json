{
  "mcpServers": {
    "next-devtools": {
      "command": "bunx",
      "args": ["-y", "next-devtools-mcp@0.4.0"]
    },
    "shadcn": {
      "command": "bun",
      "args": ["scripts/shadcn/mcp.mjs"]
    },
    "inngest-dev": {
      "type": "http",
      "url": "http://127.0.0.1:8288/mcp"
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io",
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}",
        "X-Reui-Style": "base-maia"
      }
    }
  }
}
