{
  "name": "give-hope",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/env",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@asym/admin",
    "dev:missionary": "turbo run dev --filter=@asym/missionary-app",
    "dev:donor": "turbo run dev --filter=@asym/donor",
    "dev:all": "bun run --env-file=.env.local turbo run dev --filter=@asym/admin --filter=@asym/missionary-app --filter=@asym/donor",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@asym/admin",
    "build:missionary": "turbo run build --filter=@asym/missionary-app",
    "build:donor": "turbo run build --filter=@asym/donor",
    "start": "turbo run start --filter=@asym/donor",
    "start:admin": "turbo run start --filter=@asym/admin",
    "start:missionary": "turbo run start --filter=@asym/missionary-app",
    "start:donor": "turbo run start --filter=@asym/donor",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:admin": "turbo run lint --filter=@asym/admin",
    "lint:missionary": "turbo run lint --filter=@asym/missionary-app",
    "lint:donor": "turbo run lint --filter=@asym/donor",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "typecheck": "turbo run typecheck",
    "typecheck:admin": "turbo run typecheck --filter=@asym/admin",
    "typecheck:missionary": "turbo run typecheck --filter=@asym/missionary-app",
    "typecheck:donor": "turbo run typecheck --filter=@asym/donor",
    "check": "bun run check:changed",
    "check:changed": "node scripts/check-changed-files.mjs",
    "check:full": "ultracite check",
    "test": "bun run test:unit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @perf",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:perf": "playwright test --grep @perf",
    "verify:e2e": "bun scripts/verify-e2e.mjs",
    "verify:e2e:loop": "bun scripts/verify-e2e-loop.mjs",
    "verify:t1": "bun run verify:workspace-contract",
    "verify:supabase-money": "bun run setup:verify && bun run verify:money-units",
    "verify:data-boundary": "bash scripts/verify/data-boundary-check.sh",
    "verify:lint-config": "node scripts/verify-lint-config.mjs",
    "verify:workspace-contract": "node scripts/verify-workspace-contract.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "db:migrate:local": "supabase db reset --local --no-seed",
    "db:migrate:hosted": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "seed:demo:local": "bash ./scripts/seed-demo.sh local",
    "seed:demo:hosted": "bash ./scripts/seed-demo.sh hosted",
    "seed:demo:verify": "bash ./scripts/seed-demo.sh verify",
    "verify": "node scripts/verify/index.mjs",
    "lighthouse": "lhci autorun",
    "generate:icons": "node scripts/generate-icons.js",
    "setup": "./scripts/setup",
    "setup:verify": "node scripts/setup-verify.mjs",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:cache": "rm -rf .turbo node_modules/.cache",
    "prepare": "husky",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@asym/auth": "workspace:*",
    "@asym/config": "workspace:*",
    "@asym/database": "workspace:*",
    "@asym/email": "workspace:*",
    "@asym/graphql": "workspace:*",
    "@asym/lib": "workspace:*",
    "@asym/ui": "workspace:*",
    "@google/genai": "^1.34.0",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-underline": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "graphql": "16.12.0",
    "graphql-yoga": "5.17.1",
    "require-in-the-middle": "^8.0.1",
    "shadcn": "^3.6.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@biomejs/biome": "2.4.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "canvas": "^3.2.1",
    "glob": "^13.0.4",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^16.3.2",
    "tailwindcss": "^4",
    "turbo": "^2.7.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "ultracite": "7.2.3",
    "vitest": "^2.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite fix"
    ]
  }
}
