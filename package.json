{
  "name": "give-hope",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/env",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@asym/admin",
    "dev:mission-control": "node scripts/run-with-ci-env.mjs -- bun run dev:admin",
    "dev:missionary": "turbo run dev --filter=@asym/missionary-app",
    "dev:donor": "turbo run dev --filter=@asym/donor",
    "dev:all": "bun run --env-file=.env.local turbo run dev --filter=@asym/admin --filter=@asym/missionary-app --filter=@asym/donor",
    "env:link-apps": "bun scripts/sync-root-env-to-apps.mjs",
    "build": "node scripts/run-with-ci-env.mjs -- turbo run build",
    "build:strict": "turbo run build",
    "build:admin": "node scripts/run-with-ci-env.mjs -- turbo run build --filter=@asym/admin",
    "build:admin:strict": "node scripts/run-with-ci-env.mjs -- turbo run build --filter=@asym/admin",
    "build:missionary": "node scripts/run-with-ci-env.mjs -- turbo run build --filter=@asym/missionary-app",
    "build:missionary:strict": "turbo run build --filter=@asym/missionary-app",
    "build:donor": "node scripts/run-with-ci-env.mjs -- turbo run build --filter=@asym/donor",
    "build:donor:strict": "turbo run build --filter=@asym/donor",
    "start": "turbo run start --filter=@asym/donor",
    "start:admin": "turbo run start --filter=@asym/admin",
    "start:missionary": "turbo run start --filter=@asym/missionary-app",
    "start:donor": "turbo run start --filter=@asym/donor",
    "lint": "turbo run lint",
    "lint:admin": "turbo run lint --filter=@asym/admin",
    "lint:missionary": "turbo run lint --filter=@asym/missionary-app",
    "lint:donor": "turbo run lint --filter=@asym/donor",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "ci:preflight": "node scripts/verify/ci-preflight.mjs",
    "typecheck": "turbo run typecheck",
    "typecheck:admin": "turbo run typecheck --filter=@asym/admin",
    "typecheck:missionary": "turbo run typecheck --filter=@asym/missionary-app",
    "typecheck:donor": "turbo run typecheck --filter=@asym/donor",
    "check": "bun run lint && bun run typecheck && bun run test:unit",
    "test": "bun run test:unit",
    "test:unit": "vitest run --coverage",
    "test:unit:feedback": "node scripts/verify/unit-feedback.mjs",
    "test:unit:cms": "vitest run tests/unit/cms",
    "test:e2e": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test --grep-invert \"@perf|@manual|@cms\"",
    "test:e2e:strict": "node node_modules/@playwright/test/cli.js test --grep-invert \"@perf|@manual|@cms\"",
    "test:e2e:cms": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test --grep \"@cms\" --grep-invert \"@manual\"",
    "test:e2e:cms:strict": "node node_modules/@playwright/test/cli.js test --grep \"@cms\" --grep-invert \"@manual\"",
    "test:e2e:auth-preflight": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test tests/e2e/demo-auth-preflight.spec.ts --project=chromium",
    "test:e2e:smoke": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test tests/e2e/demo-auth-preflight.spec.ts tests/e2e/usability-smoke.spec.ts tests/e2e/donate.spec.ts tests/e2e/upload-crop.spec.ts tests/e2e/support-hub.smoke.spec.ts --project=chromium --workers=1",
    "test:e2e:smoke:cms": "CMS_WEB_STUDIO_NATIVE_PAGES=true node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test tests/e2e/cms-admin-redirect.spec.ts tests/e2e/cms-publish-flow.spec.ts tests/e2e/cms-tenant-isolation.spec.ts tests/e2e/cms-ministry-updates.spec.ts tests/e2e/cms-web-studio-native.spec.ts tests/e2e/cms-templates-gallery.spec.ts",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:auth:donor": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test tests/e2e/auth-demo-donor.spec.ts --project=chromium",
    "test:e2e:auth:admin": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test -c playwright.admin.config.ts tests/e2e/auth-demo-admin.spec.ts tests/e2e/admin-table-pages-smoke.spec.ts --project=admin-boneyard",
    "test:e2e:auth:missionary": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test -c playwright.missionary.config.ts tests/e2e/auth-demo-missionary.spec.ts --project=missionary-boneyard",
    "test:e2e:boneyard:admin": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test -c playwright.admin.config.ts tests/e2e/boneyard-smoke.spec.ts --project=admin-boneyard",
    "test:e2e:boneyard:missionary": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test -c playwright.missionary.config.ts tests/e2e/boneyard-smoke.spec.ts --project=missionary-boneyard",
    "test:e2e:boneyard:donor": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test -c playwright.donor.config.ts tests/e2e/boneyard-smoke.spec.ts --project=donor-boneyard",
    "test:a11y": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test tests/e2e/accessibility.spec.ts",
    "test:a11y:strict": "node node_modules/@playwright/test/cli.js test tests/e2e/accessibility.spec.ts",
    "test:perf": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test --grep @perf --workers=1",
    "test:perf:strict": "node node_modules/@playwright/test/cli.js test --grep @perf --workers=1",
    "verify:e2e": "bun scripts/verify-e2e.mjs",
    "verify:e2e:loop": "bun scripts/verify-e2e-loop.mjs",
    "verify:t1": "bun run verify:workspace-contract",
    "verify:supabase-money": "bun run setup:verify && bun run verify:money-units",
    "verify:supabase-env": "node scripts/supabase-env-smoke.mjs",
    "verify:supabase-migrations": "node scripts/verify/supabase-migrations.mjs",
    "verify:email-studio-legacy": "node scripts/verify/email-studio-legacy-allowlist.mjs",
    "supabase": "node scripts/supabase-cli.mjs",
    "sync:vercel-production-env": "node scripts/sync-vercel-production-env.mjs",
    "configure:resend-production-webhook": "node scripts/configure-resend-production-webhook.mjs",
    "verify:eslint": "node scripts/verify-eslint-config.mjs",
    "verify:backup-restore": "node scripts/verify/backup-restore-proof.mjs",
    "verify:sentry-release": "node scripts/verify/sentry-release-sourcemaps.mjs",
    "verify:vercel-env-inventory": "node scripts/verify/vercel-env-inventory.mjs",
    "verify:vercel-production": "node scripts/verify/vercel-production-readiness.mjs",
    "verify:shadcn-diff": "node scripts/verify/shadcn-diff.mjs",
    "tsconfig:future-audit": "node scripts/tsconfig-future-audit.mjs",
    "verify:data-boundary": "node scripts/verify/data-boundary-check.mjs",
    "verify:twenty-crm-health": "bun scripts/verify/twenty-crm-health.ts",
    "verify:workspace-contract": "node scripts/verify-workspace-contract.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "skills:verify": "node scripts/verify-skills-sync.mjs",
    "skills:refresh-upstream": "node scripts/refresh-upstream-skills.mjs",
    "check:motion": "node scripts/check-motion-patterns.mjs",
    "legal:validate": "bun run --cwd apps/donor legal:validate",
    "legal:generate:md": "bun run --cwd apps/donor legal:generate:md",
    "legal:generate:html": "bun run --cwd apps/donor legal:generate:html",
    "legal:generate:pdf": "bun run --cwd apps/donor legal:generate:pdf",
    "legal:generate:all": "bun run --cwd apps/donor legal:generate:all",
    "cms:migrate": "bun run --cwd apps/admin cms:migrate",
    "cms:migrate:create": "bun run --cwd apps/admin cms:migrate:create",
    "cms:migrate:status": "bun run --cwd apps/admin cms:migrate:status",
    "cms:importmap": "bun run --cwd apps/admin cms:importmap",
    "site-studio:walkthrough:cloud": "bash ./scripts/dev/site-studio-cloud-walkthrough.sh",
    "db:migrate:local": "bun run supabase -- db reset --local --no-seed",
    "db:migrate:hosted": "node scripts/db-migrate-hosted.mjs",
    "seed:demo:local": "bash ./scripts/seed-demo.sh local",
    "seed:demo:hosted": "bash ./scripts/seed-demo.sh hosted",
    "seed:demo:verify": "bash ./scripts/seed-demo.sh verify",
    "seed:demo:users": "bun run --cwd packages/database seed:demo-users",
    "verify": "node scripts/verify/index.mjs",
    "react-doctor:first-party": "node scripts/react-doctor-first-party.mjs",
    "validate:full": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run test:e2e && bun run test:a11y && bun run test:perf && bun run verify && bun run verify:eslint && bun run prepare && bun run build",
    "lighthouse": "lhci autorun",
    "generate:icons": "node scripts/generate-icons.js",
    "shadcn:uikit:add": "bun scripts/shadcn/add-shadcnuikit.ts",
    "setup": "bash ./scripts/setup/index.sh",
    "setup:mission-control:cloud": "node scripts/dev/setup-mission-control-cloud.mjs",
    "setup:verify": "node scripts/setup-verify.mjs",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:cache": "rm -rf .turbo node_modules/.cache",
    "boneyard:admin": "cd apps/admin && bunx boneyard-js build http://localhost:3030/boneyard/contributions",
    "boneyard:missionary": "cd apps/missionary && bunx boneyard-js build http://localhost:4000/boneyard/tasks",
    "boneyard:donor": "cd apps/donor && bunx boneyard-js build http://localhost:3000/boneyard/donor-dashboard --breakpoints 1280",
    "boneyard:all": "bun run boneyard:admin && bun run boneyard:missionary && bun run boneyard:donor",
    "boneyard:admin:force": "cd apps/admin && bunx boneyard-js build http://localhost:3030/boneyard/contributions --force",
    "boneyard:missionary:force": "cd apps/missionary && bunx boneyard-js build http://localhost:4000/boneyard/tasks --force",
    "boneyard:donor:force": "cd apps/donor && bunx boneyard-js build http://localhost:3000/boneyard/donor-dashboard --force --breakpoints 1280",
    "boneyard:force": "bun run boneyard:admin:force && bun run boneyard:missionary:force && bun run boneyard:donor:force",
    "prepare": "husky",
    "postinstall": "node scripts/dedupe-tanstack-db.mjs"
  },
  "dependencies": {
    "@asym/auth": "workspace:*",
    "@asym/config": "workspace:*",
    "@asym/database": "workspace:*",
    "@asym/email": "workspace:*",
    "@asym/env": "workspace:*",
    "@asym/graphql": "workspace:*",
    "@asym/lib": "workspace:*",
    "@asym/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "graphql": "16.12.0",
    "graphql-yoga": "5.17.1",
    "next": "16.2.6",
    "require-in-the-middle": "^8.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@asym/eslint-config": "workspace:*",
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/cli": "^0.63.1",
    "@testing-library/react": "^16.3.0",
    "@tiptap/react": "^3.22.3",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "canvas": "^3.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4",
    "turbo": "^2.9.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@tanstack/db": "0.6.4"
  },
  "lint-staged": {
    "{apps,packages,tooling}/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{apps,packages,tooling,docs,.github}/**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "./{README.md,package.json,turbo.json,tsconfig.json}": [
      "prettier --write"
    ]
  }
}
