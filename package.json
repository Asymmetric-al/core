    "test:e2e:auth:admin": "node scripts/run-with-ci-env.mjs -- node node_modules/@playwright/test/cli.js test -c playwright.admin.config.ts tests/e2e/auth-demo-admin.spec.ts tests/e2e/admin-table-pages-smoke.spec.ts tests/e2e/admin-tenant-address.spec.ts tests/e2e/admin-request-scope.spec.ts --project=admin-boneyard",
