# ---------------------------------------------------------------------------
# Environment Matrix
# - Local:       local dev (`bun run dev:*`)
# - Preview:     Vercel preview deployments
# - Development: hosted develop custom env (VERCEL_TARGET_ENV=core-development)
# - Production:  Vercel production deployments
# - Vercel's built-in `development` target is local-only (`vercel dev`) and is
#   intentionally not treated as a protected hosted deployment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Vercel system vars (provided by Vercel in hosted deployments)
# Local: optional
# Preview/Development/Production: automatically populated by Vercel
# ---------------------------------------------------------------------------
VERCEL_ENV=
VERCEL_TARGET_ENV=
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_VERCEL_TARGET_ENV=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Required: Local + Preview + Development + Production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional modern key name; takes precedence over anon when both are set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required: Development + Production (optional for Local + Preview)
SUPABASE_SERVICE_ROLE_KEY=

# Optional connection string for local operator scripts only. Never set it in an
# application environment (Vercel): no app runtime holds a `postgres` login, and
# hosted databases migrate only through the release job (docs/ops/release-job.md;
# `bun run verify:runtime-connection-strings` checks the Vercel projects).
# Supabase direct `db.<project-ref>.supabase.co` is often IPv6-only; use the
# **Session pooler** from Dashboard → Connect (host like `aws-0-<region>.pooler.supabase.com`,
# user `postgres.<project-ref>`, port 5432) on IPv4-only dev hosts.
# Node may need `?sslmode=no-verify` for the pooler in local dev (see Supabase SSL docs).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Eve GitHub App review channel (server-only; release remains governance-gated)
# ---------------------------------------------------------------------------
# GitHub App credentials. Prefer Vercel Connect in hosted environments; these
# direct values are supported by Eve 0.25.1 and never enter the sandbox.
EVE_GITHUB_CONNECT_UID=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Tenant-linked platform actor used only for #423 policy accounting. The
# verified GitHub sender remains the accountable initiator in every #419 audit.
EVE_GITHUB_TENANT_ID=
EVE_GITHUB_ACTOR_PROFILE_ID=
EVE_GITHUB_APP_SLUG=
# Optional comma-separated numeric GitHub App IDs approved to issue Eve
# commands through signed App-authored comments. Empty denies bot commands.
EVE_APPROVED_COMMAND_APP_IDS=

# Optional server-only Discord destination for urgent Eve operator alerts.
# The value is never persisted or returned by Mission Control.
EVE_DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Eve final launch target (server-only; values identify, never authorize)
# ---------------------------------------------------------------------------
# Set these to the exact immutable deployment only when assembling the #437
# launch manifest. Missing or mismatched values keep activation unavailable.
# EVE_LAUNCH_REVISION may be omitted on Vercel when VERCEL_GIT_COMMIT_SHA is set.
# EVE_LAUNCH_DEPLOYMENT_ID may be omitted when VERCEL_DEPLOYMENT_ID is available.
EVE_LAUNCH_DEPLOYMENT_ID=
EVE_LAUNCH_ENVIRONMENT=
EVE_LAUNCH_REVISION=
EVE_LAUNCH_MIGRATION_VERSION=
EVE_LAUNCH_POLICY_VERSION=
EVE_LAUNCH_MODEL_POLICY_REVISION=
EVE_LAUNCH_EVAL_CONFIG_REVISION=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Optional for Local + Preview; recommended in Development + Production
# Publishable keys start with pk_test_ (test) or pk_live_ (live) — see https://docs.stripe.com/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Required: Development + Production (optional for Local + Preview)
# Secret keys start with sk_test_ or sk_live_
STRIPE_SECRET_KEY=
# Webhook signing secrets start with whsec_ — required to verify Stripe webhooks
STRIPE_WEBHOOK_SECRET=
# Optional signing secret (whsec_...) of the thin event destination for Accounts v2 account events,
# delivered to admin /api/webhooks/stripe-connect.
# While unset, the connected-accounts endpoint returns 503 without touching the database.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mission Control Payouts (optional, server-only feature gates)
# ---------------------------------------------------------------------------
# Defaults are safe/off when unset. These flags do not contain credentials and
# must not be used as proof that a tenant provider account is connected.
PAYOUTS_ENABLED=false
PAYOUTS_MANUAL_PROVIDER_ENABLED=false
PAYOUTS_WISE_ENABLED=false
PAYOUTS_AIRWALLEX_ENABLED=false
PAYOUTS_CURRENCYCLOUD_ENABLED=false
PAYOUTS_CORPAY_ENABLED=false
PAYOUTS_STRIPE_GLOBAL_PAYOUTS_ENABLED=false
PAYOUTS_EXECUTION_ENABLED=false
PAYOUTS_SANDBOX_ONLY=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Optional public DSN
NEXT_PUBLIC_SENTRY_DSN=

# Experimental opt-in for @asym/ui's React View Transition boundaries
# (packages/lib/view-transitions/flags.ts). Default off.
NEXT_PUBLIC_VIEW_TRANSITIONS_ENABLED=false

# Required: Development + Production (optional for Local + Preview)
SENTRY_DSN=

# Optional build-only source map upload settings. Never expose or commit token values.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=asymmetrical-4w
SENTRY_PROJECT=javascript-nextjs
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# Toggle for Cloudinary upload path
NEXT_PUBLIC_CLOUDINARY_ENABLED=false

# Optional: single URL form (some CLIs/SDKs); this app reads split vars below.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Required only when NEXT_PUBLIC_CLOUDINARY_ENABLED=true in Development/Production
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Demo accounts and cron
# ---------------------------------------------------------------------------
# Demo identity values (optional; required only if demo login is enabled)
DEMO_ADMIN_EMAIL=
DEMO_MISSIONARY_EMAIL=
DEMO_DONOR_EMAIL=
DEMO_DELIVERY_EMAIL=
DEMO_TICKETING_EMAIL=
DEMO_MACHINERY_EMAIL=
DEMO_PASSWORD=
DEMO_ONLY_LOGIN=false

# Demo guard (defaults to false)
ALLOW_DEMO_ACCOUNTS=false

# Bearer secret for the demo-user cleanup endpoint, which returns 503 while this
# is unset. When set, the database health route also requires it.
CRON_SECRET=

# Payload CMS (optional; required when running Site Studio locally).
# Payload reads only PAYLOAD_DATABASE_URI; it never falls back to
# SUPABASE_DB_URL. Hosted deployments connect as the `cms_runtime` login
# through the Supavisor session pooler (user `cms_runtime.<project-ref>`);
# Web Studio refuses any other role there. Local development may use the local
# superuser URL.
PAYLOAD_SECRET=
PAYLOAD_DATABASE_URI=
# The `cms_owner` connection for Payload migrations. Only the release job's
# CMS migration step sets it; never put it in an application environment
# (Web Studio refuses to start on a protected deployment that holds it).
# Unset locally: on a loopback database `cms:migrate` reuses
# PAYLOAD_DATABASE_URI with the session role set to `cms_owner`.
PAYLOAD_MIGRATION_DATABASE_URI=
# Server-only public CA PEM from Supabase Database settings. With this set,
# use sslmode=verify-full and omit all other SSL URI options.
PAYLOAD_DATABASE_SSL_CA=
# Optional. Hosted/Vercel Web Studio defaults to 2 because Payload keeps one
# startup Postgres client checked out and needs one query slot left open.
PAYLOAD_DATABASE_POOL_MAX=
# Local deterministic CMS setup uses committed Payload migrations instead of
# development schema push markers.
PAYLOAD_DISABLE_SCHEMA_PUSH=1
CMS_BASE_URL=
# Local-only public CMS tenant fallback for loopback hosts (`localhost`,
# `127.0.0.1`, `[::1]`). Ignored in production.
CMS_LOCAL_DEFAULT_TENANT_SLUG=give-hope-demo

# ---------------------------------------------------------------------------
# App URLs and branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MAIN_DOMAIN=

# Email Studio is React Email only. These two flags remain in the env schema for
# compatibility but no longer switch the email editor. The NEXT_PUBLIC_UNLAYER_*
# block below is for PDF Studio and reading legacy builder='unlayer' DB rows.
NEXT_PUBLIC_EMAIL_STUDIO_BUILDER=react_email
NEXT_PUBLIC_EMAIL_STUDIO_LEGACY_UNLAYER_ENABLED=false

# Legacy Unlayer configuration retained only for existing Unlayer templates and PDF Studio.
NEXT_PUBLIC_UNLAYER_PROJECT_ID=
NEXT_PUBLIC_UNLAYER_WHITE_LABEL=false
NEXT_PUBLIC_UNLAYER_ALLOWED_DOMAINS=
# Legacy Unlayer REST/API key. No app or package reads it, and @asym/env does
# not validate it.
UNLAYER_API_KEY=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Required: Development + Production (optional for Local + Preview)
# Server-only API keys start with re_
RESEND_API_KEY=
# Required: Development + Production (optional for Local + Preview)
# Webhook signing secrets start with whsec_
RESEND_WEBHOOK_SECRET=
# Required: Development + Production (optional for Local + Preview)
# Must be at least 32 characters; rotation requires re-encrypting stored keys
RESEND_ENCRYPTION_KEY=

# Optional Payload auth email sender override. When unset, Payload uses
# Mission Control <noreply@asymmetric.al> with the shared Resend API key.
PAYLOAD_EMAIL_FROM_ADDRESS=
PAYLOAD_EMAIL_FROM_NAME=

# Optional Web Studio media storage. Vercel sets this automatically after
# connecting a Blob store to the admin project.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# MCP / local tooling (optional)
# ---------------------------------------------------------------------------
# The shadcn MCP reads the "Shadcn private registries" names below.
GITHUB_TOKEN=
NIA_API_KEY=
NIA_API_URL=

NEXT_PUBLIC_BRAND_NAME=GiveHope
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0f172a
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#2563eb
NEXT_PUBLIC_EMAIL_FOOTER_TEXT=
NEXT_PUBLIC_PDF_FOOTER_TEXT=

# Optional server-side DocRaptor HTML-to-PDF/XLS API key.
# Keep server-only: never prefix with NEXT_PUBLIC_.
DOCRAPTOR_API_KEY=

# ---------------------------------------------------------------------------
# Build metadata (optional)
# Used by /help/about and source/license links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_VERSION=
APP_VERSION=
NEXT_PUBLIC_GIT_REF=
GIT_REF=
NEXT_PUBLIC_GIT_SHA=
GIT_SHA=
NEXT_PUBLIC_BUILD_DATE=
BUILD_DATE=
SOURCE_DATE_EPOCH=

# CI/hosting fallback metadata (normally auto-populated by providers)
GITHUB_SHA=
RENDER_GIT_COMMIT=
FLY_IMAGE_REF=

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
E2E_AUTH_BYPASS=false
# The organization the E2E bypass signs in to; required when E2E_AUTH_BYPASS=true (the seed's demo organization)
E2E_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000001
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3005
PLAYWRIGHT_PORT=3005
VERIFY_E2E_PROJECTS=
# Playwright donor-authenticated tests (global setup writes .auth/donor.json)
E2E_DONOR_EMAIL=
E2E_DONOR_PASSWORD=
# Playwright admin-authenticated tests (global setup writes .auth/admin.json)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Skip writing real auth; use empty storage files (authenticated E2E will fail without real login)
SKIP_E2E_AUTH=

# ---------------------------------------------------------------------------
# Shadcn private registries (optional)
# ---------------------------------------------------------------------------
# These values are only needed for paid/private registry access. Keep real
# values in local/hosted secret stores only; never commit registry credentials.
# Names match packages/ui/components.json, which the shadcn CLI and the
# project shadcn MCP (scripts/shadcn/mcp.mjs) read from the environment.
# shadcnstudio registries (@ss-components, @ss-themes, @ss-blocks, @ss-pages,
# @ss-illustrations; @shadcn-studio is free)
SHADCN_STUDIO_EMAIL=
SHADCN_STUDIO_LICENSE_KEY=
# Shadcnblocks registry
SHADCNBLOCKS_API_KEY=
# Efferd registry
EFFERD_REGISTRY_TOKEN=
# React Bits Pro registries
REACTBITS_LICENSE_KEY=
# ReUI Pro registry and headless MCP (available as a runtime secret in cloud)
REUI_LICENSE_KEY=
# shadcnuikit registry
SHADCNUIKIT_API_KEY=
# shadcnuikit install wrapper (bun run shadcn:uikit:add)
REGISTRY_TOKEN=

# Set to 1/true only for CI or controlled local debugging
SKIP_ENV_VALIDATION=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
