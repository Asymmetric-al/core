# ---------------------------------------------------------------------------
# Environment Matrix
# - Local:       local dev (`bun run dev:*`)
# - Preview:     Vercel preview deployments
# - Staging:     custom Vercel environment (expected: VERCEL_TARGET_ENV=staging)
# - Production:  Vercel production deployments
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Vercel system vars (provided by Vercel in hosted deployments)
# Local: optional
# Preview/Staging/Production: automatically populated by Vercel
# ---------------------------------------------------------------------------
VERCEL_ENV=
VERCEL_TARGET_ENV=
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Required: Local + Preview + Staging + Production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional modern key name; takes precedence over anon when both are set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required: Staging + Production (optional for Local + Preview)
SUPABASE_SERVICE_ROLE_KEY=

# Optional utility connection string (hosted migration scripts).
# Supabase direct `db.<project-ref>.supabase.co` is often IPv6-only; use the
# **Session pooler** from Dashboard → Connect (host like `aws-0-<region>.pooler.supabase.com`,
# user `postgres.<project-ref>`, port 5432) on IPv4-only dev hosts.
# Node may need `?sslmode=no-verify` for the pooler in local dev (see Supabase SSL docs).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Optional for Local + Preview; recommended in Staging + Production
# Publishable keys start with pk_test_ (test) or pk_live_ (live) — see https://docs.stripe.com/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Required: Staging + Production (optional for Local + Preview)
# Secret keys start with sk_test_ or sk_live_
STRIPE_SECRET_KEY=
# Webhook signing secrets start with whsec_ — required to verify Stripe webhooks
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mission Control Payouts (optional, server-only feature gates)
# ---------------------------------------------------------------------------
# Defaults are safe/off when unset. These flags do not contain credentials and
# must not be used as proof that a tenant provider account is connected.
PAYOUTS_ENABLED=false
PAYOUTS_MANUAL_PROVIDER_ENABLED=false
PAYOUTS_WISE_ENABLED=false
PAYOUTS_AIRWALLEX_ENABLED=false
PAYOUTS_CURRENCYCLOUD_ENABLED=false
PAYOUTS_CORPAY_ENABLED=false
PAYOUTS_STRIPE_GLOBAL_PAYOUTS_ENABLED=false
PAYOUTS_EXECUTION_ENABLED=false
PAYOUTS_SANDBOX_ONLY=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Optional public DSN
NEXT_PUBLIC_SENTRY_DSN=

# Experimental: React View Transitions (Next `experimental.viewTransition`). Default off.
NEXT_PUBLIC_VIEW_TRANSITIONS_ENABLED=false

# Required: Staging + Production (optional for Local + Preview)
SENTRY_DSN=

# Optional build-only source map upload settings. Never expose or commit token values.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=asymmetrical-4w
SENTRY_PROJECT=javascript-nextjs
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# Toggle for Cloudinary upload path
NEXT_PUBLIC_CLOUDINARY_ENABLED=false

# Optional: single URL form (some CLIs/SDKs); this app reads split vars below.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Required only when NEXT_PUBLIC_CLOUDINARY_ENABLED=true in Staging/Production
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Demo accounts and cron
# ---------------------------------------------------------------------------
# Demo identity values (optional; required only if demo login is enabled)
DEMO_ADMIN_EMAIL=
DEMO_MISSIONARY_EMAIL=
DEMO_DONOR_EMAIL=
DEMO_DELIVERY_EMAIL=
DEMO_TICKETING_EMAIL=
DEMO_MACHINERY_EMAIL=
DEMO_PASSWORD=
DEMO_ONLY_LOGIN=false

# Demo guard (defaults to false)
ALLOW_DEMO_ACCOUNTS=false

# Optional auth for scheduled cleanup endpoint
CRON_SECRET=

# Payload CMS (optional; required when running Site Studio locally).
# Prefer the Supavisor session-pooler connection string here when the host
# running Payload cannot reach Supabase direct IPv6 database hosts.
# Monorepo: root `.env.local` is loaded by `loadEnvConfig` in each app’s
# `next.config.ts`, so `SUPABASE_DB_URL` here is enough unless you want a
# separate pooler URL for Payload only (`PAYLOAD_DATABASE_URI`).
PAYLOAD_SECRET=
PAYLOAD_DATABASE_URI=
CMS_BASE_URL=

# ---------------------------------------------------------------------------
# App URLs and branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MAIN_DOMAIN=

# Email Studio builder runtime. New email templates default to React Email.
NEXT_PUBLIC_EMAIL_STUDIO_BUILDER=react_email
NEXT_PUBLIC_EMAIL_STUDIO_LEGACY_UNLAYER_ENABLED=true

# Legacy Unlayer configuration retained only for existing Unlayer templates and PDF Studio.
NEXT_PUBLIC_UNLAYER_PROJECT_ID=
NEXT_PUBLIC_UNLAYER_WHITE_LABEL=false
NEXT_PUBLIC_UNLAYER_ALLOWED_DOMAINS=
# Optional legacy Unlayer REST/API access (not validated by @asym/env)
UNLAYER_API_KEY=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Required: Staging + Production (optional for Local + Preview)
# Server-only API keys start with re_
RESEND_API_KEY=
# Required: Staging + Production (optional for Local + Preview)
# Webhook signing secrets start with whsec_
RESEND_WEBHOOK_SECRET=
# Required: Staging + Production (optional for Local + Preview)
# Must be at least 32 characters; rotation requires re-encrypting stored keys
RESEND_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Twenty CRM (server-only; Phase 01 gateway/proof routes and Phase 03 sync)
# ---------------------------------------------------------------------------
# Optional until the non-production Twenty proof is connected.
# Base URL should point at the Twenty API host. Core API paths live under /rest/
# and metadata paths under /rest/metadata/ or /metadata/ depending on the call.
TWENTY_API_URL=
TWENTY_API_KEY=
TWENTY_WEBHOOK_SECRET=
TWENTY_WORKSPACE_ID=
TWENTY_RATE_LIMIT_RPM=100
# Phase 03 sync flags default off. Enable only in non-production proof/staging
# until later phases authorize production cutover.
CRM_SYNC_INBOUND_ENABLED=false
CRM_SYNC_OUTBOUND_ENABLED=false
CRM_SYNC_REPLAY_ENABLED=false
CRM_SYNC_RECONCILIATION_ENABLED=false
CRM_SYNC_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# MCP / local tooling (optional)
# ---------------------------------------------------------------------------
SHADCN_EMAIL=
SHADCN_LICENSE_KEY=
GITHUB_TOKEN=
NIA_API_KEY=
NIA_API_URL=

NEXT_PUBLIC_BRAND_NAME=GiveHope
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0f172a
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#2563eb
NEXT_PUBLIC_EMAIL_FOOTER_TEXT=
NEXT_PUBLIC_PDF_FOOTER_TEXT=

# Optional server-side DocRaptor HTML-to-PDF/XLS API key.
# Keep server-only: never prefix with NEXT_PUBLIC_.
DOCRAPTOR_API_KEY=

# ---------------------------------------------------------------------------
# Build metadata (optional)
# Used by /help/about and source/license links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_VERSION=
APP_VERSION=
NEXT_PUBLIC_GIT_REF=
GIT_REF=
NEXT_PUBLIC_GIT_SHA=
GIT_SHA=
NEXT_PUBLIC_BUILD_DATE=
BUILD_DATE=
SOURCE_DATE_EPOCH=

# CI/hosting fallback metadata (normally auto-populated by providers)
GITHUB_SHA=
RENDER_GIT_COMMIT=
FLY_IMAGE_REF=

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
E2E_AUTH_BYPASS=false
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3005
PLAYWRIGHT_PORT=3005
VERIFY_E2E_PROJECTS=
# Playwright donor-authenticated tests (global setup writes .auth/donor.json)
E2E_DONOR_EMAIL=
E2E_DONOR_PASSWORD=
# Playwright admin-authenticated tests (global setup writes .auth/admin.json)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Skip writing real auth; use empty storage files (authenticated E2E will fail without real login)
SKIP_E2E_AUTH=

# shadcn registries (optional)
REGISTRY_TOKEN=

# Set to 1/true only for CI or controlled local debugging
SKIP_ENV_VALIDATION=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
