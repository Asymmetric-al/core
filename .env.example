# ---------------------------------------------------------------------------
# Environment Matrix
# - Local:       local dev (`bun run dev:*`)
# - Preview:     Vercel preview deployments
# - Staging:     custom Vercel environment (expected: VERCEL_TARGET_ENV=staging)
# - Production:  Vercel production deployments
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Vercel system vars (provided by Vercel in hosted deployments)
# Local: optional
# Preview/Staging/Production: automatically populated by Vercel
# ---------------------------------------------------------------------------
VERCEL_ENV=
VERCEL_TARGET_ENV=
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Required: Local + Preview + Staging + Production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional modern key name; takes precedence over anon when both are set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required: Staging + Production (optional for Local + Preview)
SUPABASE_SERVICE_ROLE_KEY=

# Optional utility connection string (hosted migration scripts).
# Supabase direct `db.<project-ref>.supabase.co` is often IPv6-only; use the
# **Session pooler** from Dashboard → Connect (host like `aws-0-<region>.pooler.supabase.com`,
# user `postgres.<project-ref>`, port 5432) on IPv4-only dev hosts.
# Node may need `?sslmode=no-verify` for the pooler in local dev (see Supabase SSL docs).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Optional for Local + Preview; recommended in Staging + Production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Required: Staging + Production (optional for Local + Preview)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Optional public DSN
NEXT_PUBLIC_SENTRY_DSN=

# Experimental: React View Transitions (Next `experimental.viewTransition`). Default off.
NEXT_PUBLIC_VIEW_TRANSITIONS_ENABLED=false

# Required: Staging + Production (optional for Local + Preview)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# Toggle for Cloudinary upload path
NEXT_PUBLIC_CLOUDINARY_ENABLED=false

# Required only when NEXT_PUBLIC_CLOUDINARY_ENABLED=true in Staging/Production
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Demo accounts and cron
# ---------------------------------------------------------------------------
# Demo identity values (optional; required only if demo login is enabled)
DEMO_ADMIN_EMAIL=
DEMO_MISSIONARY_EMAIL=
DEMO_DONOR_EMAIL=
DEMO_DELIVERY_EMAIL=
DEMO_TICKETING_EMAIL=
DEMO_MACHINERY_EMAIL=
DEMO_PASSWORD=
DEMO_ONLY_LOGIN=false

# Demo guard (defaults to false)
ALLOW_DEMO_ACCOUNTS=false

# Optional auth for scheduled cleanup endpoint
CRON_SECRET=

# Payload CMS (optional; required when running Site Studio locally).
# Prefer the Supavisor session-pooler connection string here when the host
# running Payload cannot reach Supabase direct IPv6 database hosts.
# Monorepo: root `.env.local` is loaded by `loadEnvConfig` in each app’s
# `next.config.ts`, so `SUPABASE_DB_URL` here is enough unless you want a
# separate pooler URL for Payload only (`PAYLOAD_DATABASE_URI`).
PAYLOAD_SECRET=
PAYLOAD_DATABASE_URI=
CMS_BASE_URL=

# ---------------------------------------------------------------------------
# App URLs and branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MAIN_DOMAIN=

NEXT_PUBLIC_UNLAYER_PROJECT_ID=
NEXT_PUBLIC_UNLAYER_WHITE_LABEL=false
NEXT_PUBLIC_UNLAYER_ALLOWED_DOMAINS=

NEXT_PUBLIC_BRAND_NAME=GiveHope
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0f172a
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#2563eb
NEXT_PUBLIC_EMAIL_FOOTER_TEXT=
NEXT_PUBLIC_PDF_FOOTER_TEXT=

# ---------------------------------------------------------------------------
# Build metadata (optional)
# Used by /help/about and source/license links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_VERSION=
APP_VERSION=
NEXT_PUBLIC_GIT_REF=
GIT_REF=
NEXT_PUBLIC_GIT_SHA=
GIT_SHA=
NEXT_PUBLIC_BUILD_DATE=
BUILD_DATE=
SOURCE_DATE_EPOCH=

# CI/hosting fallback metadata (normally auto-populated by providers)
GITHUB_SHA=
RENDER_GIT_COMMIT=
FLY_IMAGE_REF=

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
E2E_AUTH_BYPASS=false
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3005
PLAYWRIGHT_PORT=3005
VERIFY_E2E_PROJECTS=
# Playwright donor-authenticated tests (global setup writes .auth/donor.json)
E2E_DONOR_EMAIL=
E2E_DONOR_PASSWORD=
# Playwright admin-authenticated tests (global setup writes .auth/admin.json)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Skip writing real auth; use empty storage files (authenticated E2E will fail without real login)
SKIP_E2E_AUTH=

# shadcn registries (optional)
REGISTRY_TOKEN=

# Set to 1/true only for CI or controlled local debugging
SKIP_ENV_VALIDATION=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
